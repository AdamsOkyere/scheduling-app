generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  name      String
  email     String
  phone     String?
  note      String?
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())

  @@index([email])
  @@index([status, startTime])
}
